    "drizzle-orm": "0.38.3",
    "hono": "4.6.16",
    "lucide-react": "0.471.0",
    "next": "15.1.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/workers-types": "4.20250109.0",
    "@opennextjs/cloudflare": "0.3.8",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "drizzle-kit": "0.30.1",
